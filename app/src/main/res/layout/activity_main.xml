<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 开关 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_auto"
            android:textSize="16sp"
            android:paddingVertical="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_lock_screen"
            android:textSize="16sp"
            android:paddingVertical="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchPeriodic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/periodic_enable"
            android:textSize="16sp"
            android:paddingVertical="12dp" />

        <EditText
            android:id="@+id/etInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="@string/interval_hint"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="8dp" />

        <!-- API URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/api_url"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_url_hint"
            android:inputType="textUri|textMultiLine|textNoSuggestions"
            android:minLines="3"
            android:gravity="top"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="4dp" />

        <!-- 上次切换时间 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/last_applied"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvLastApplied"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/never"
            android:textSize="13sp"
            android:textColor="#666666" />

        <!-- 解锁触发诊断（用于确认广播是否到达） -->
        <TextView
            android:id="@+id/tvUnlockInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#666666" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vivo_tip"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="16dp" />

        <!-- 按钮 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <Button
            android:id="@+id/btnNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_now"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnBrowse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/browse_6"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
